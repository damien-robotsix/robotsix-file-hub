# ── Logging ────────────────────────────────────────────────────────
# Log level for the application (DEBUG, INFO, WARNING, ERROR, CRITICAL).
FILE_HUB_LOG_LEVEL=INFO

# ── Database ────────────────────────────────────────────────────────
# SQLAlchemy async database URL.
#
# Docker Compose (PostgreSQL with pgvector):
FILE_HUB_DATABASE_URL=postgresql+asyncpg://file_hub:file_hub@localhost:5432/file_hub
#
# Local SQLite (zero-config):
# FILE_HUB_DATABASE_URL=sqlite+aiosqlite:///./file_hub.db

# ── Storage ────────────────────────────────────────────────────────
# "local" (filesystem) or "s3" (S3-compatible object storage).
#
# Docker Compose (MinIO):
FILE_HUB_STORAGE_BACKEND=s3
#
# Local filesystem:
# FILE_HUB_STORAGE_BACKEND=local

# Filesystem path when using local storage (default: ./uploads).
FILE_HUB_LOCAL_STORAGE_PATH=./uploads

# ── S3 / MinIO ─────────────────────────────────────────────────────
# Docker Compose defaults (MinIO):
FILE_HUB_S3_ENDPOINT=http://localhost:9000
FILE_HUB_S3_BUCKET=file-hub
FILE_HUB_S3_ACCESS_KEY=minioadmin
FILE_HUB_S3_SECRET_KEY=minioadmin
FILE_HUB_S3_REGION=us-east-1

# ── Authentication ────────────────────────────────────────────────
# Bearer token for protecting API endpoints.
# Leave empty for development (no authentication required).
FILE_HUB_AUTH_TOKEN=

# ── Upload Limits ──────────────────────────────────────────────────
# Maximum file size in bytes (default: 100 MB).
FILE_HUB_MAX_FILE_SIZE=104857600

# ── LLM Enrichment ─────────────────────────────────────────────────
# OpenAI-compatible API endpoint.  Defaults to a local Ollama instance.
FILE_HUB_ENRICHMENT_LLM_API_BASE=http://localhost:11434/v1

# API key for the LLM service (empty = no auth, e.g. for local Ollama).
FILE_HUB_ENRICHMENT_LLM_API_KEY=

# Model name used for summary/category/tag generation.
FILE_HUB_ENRICHMENT_LLM_MODEL=llama3.1

# HTTP timeout in seconds for LLM API calls.
FILE_HUB_ENRICHMENT_LLM_TIMEOUT=30.0

# Maximum tokens in the LLM completion response.
FILE_HUB_ENRICHMENT_LLM_MAX_TOKENS=256

# Optional separate embedding model.  When empty, uses the enrichment model.
# FILE_HUB_ENRICHMENT_LLM_EMBEDDING_MODEL=text-embedding-3-small

# ── Search ─────────────────────────────────────────────────────────
# Hybrid search vector weight (0.0 = keyword only, 1.0 = vector only).
FILE_HUB_SEARCH_VECTOR_WEIGHT=0.7

# ── Local Embeddings ───────────────────────────────────────────────
# sentence-transformers model for local embedding generation.
# Downloaded automatically on first use.
FILE_HUB_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
