{
  "description": "Every setting file-hub reads at runtime.",
  "properties": {
    "database_url": {
      "default": "sqlite+aiosqlite:///./file_hub.db",
      "title": "Database Url",
      "type": "string"
    },
    "storage_backend": {
      "default": "local",
      "title": "Storage Backend",
      "type": "string"
    },
    "local_storage_path": {
      "default": "./uploads",
      "title": "Local Storage Path",
      "type": "string"
    },
    "s3_endpoint": {
      "default": "",
      "title": "S3 Endpoint",
      "type": "string"
    },
    "s3_bucket": {
      "default": "file-hub",
      "title": "S3 Bucket",
      "type": "string"
    },
    "s3_access_key": {
      "default": "",
      "title": "S3 Access Key",
      "type": "string"
    },
    "s3_secret_key": {
      "default": "",
      "format": "password",
      "title": "S3 Secret Key",
      "type": "string",
      "writeOnly": true
    },
    "s3_region": {
      "default": "us-east-1",
      "title": "S3 Region",
      "type": "string"
    },
    "max_file_size": {
      "default": 104857600,
      "title": "Max File Size",
      "type": "integer"
    },
    "auth_token": {
      "default": "",
      "format": "password",
      "title": "Auth Token",
      "type": "string",
      "writeOnly": true
    },
    "enrichment_llm_api_base": {
      "default": "http://localhost:11434/v1",
      "title": "Enrichment Llm Api Base",
      "type": "string"
    },
    "enrichment_llm_api_key": {
      "default": "",
      "format": "password",
      "title": "Enrichment Llm Api Key",
      "type": "string",
      "writeOnly": true
    },
    "enrichment_llm_model": {
      "default": "llama3.1",
      "title": "Enrichment Llm Model",
      "type": "string"
    },
    "enrichment_llm_timeout": {
      "default": 30.0,
      "title": "Enrichment Llm Timeout",
      "type": "number"
    },
    "enrichment_llm_max_tokens": {
      "default": 256,
      "title": "Enrichment Llm Max Tokens",
      "type": "integer"
    },
    "enrichment_llm_embedding_model": {
      "default": "bge-m3",
      "title": "Enrichment Llm Embedding Model",
      "type": "string"
    },
    "search_vector_weight": {
      "default": 0.7,
      "title": "Search Vector Weight",
      "type": "number"
    },
    "log_level": {
      "default": "INFO",
      "title": "Log Level",
      "type": "string"
    }
  },
  "title": "Settings",
  "type": "object"
}
